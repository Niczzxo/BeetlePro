// Dostelo core database schema.
// PostgreSQL via Prisma. Money is stored as integer minor units
// (paisa) plus an ISO currency code. All timestamps are UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum ReservationState {
  ACTIVE
  RELEASED
  FINALIZED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum DeliveryZone {
  DHAKA_CITY
  DHAKA_SUB_CITY
  OUTSIDE_DHAKA
}

enum PaymentGateway {
  BKASH
  NAGAD
  ROCKET
  UPAY
  SSLCOMMERZ
  SHURJOPAY
  CARD
  COD
}

enum PaymentChannel {
  COD
  MANUAL
  GATEWAY
}

enum PaymentStatus {
  INITIATED
  AWAITING_CUSTOMER
  VERIFICATION_PENDING
  PENDING
  PENDING_COLLECTION
  SUCCESSFUL
  COLLECTED
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  MANUAL_PENDING
  GATEWAY_NOT_CONFIGURED
  COMPLETED
  REJECTED
}

enum AuditActorType {
  ADMIN
  CUSTOMER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?
  name         String
  customer     Customer?
  adminUser    AdminUser?
  sessions     Session[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Customer {
  id                 String            @id @default(uuid())
  userId             String?           @unique
  user               User?             @relation(fields: [userId], references: [id])
  fullName           String
  email              String?
  phone              String
  isPhoneVerified    Boolean           @default(false)
  isEmailVerified    Boolean           @default(false)
  tags               String[]
  orderCount         Int               @default(0)
  lifetimeValueMinor Int               @default(0)
  currency           String            @default("BDT")
  addresses          CustomerAddress[]
  carts              Cart[]
  orders             Order[]
  notes              CustomerNote[]
  customerTags       CustomerTag[]
  identityLinks      IdentityLink[]
  leads              Lead[]
  abandonedCarts     AbandonedCart[]
  communications     CommunicationLog[]
  loyaltyTransactions LoyaltyTransaction[]
  visitorSessions    VisitorSession[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([phone])
  @@index([email])
}

model CustomerAddress {
  id           String       @id @default(uuid())
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  label        String?
  fullName     String
  phone        String
  addressLine  String
  area         String?
  city         String
  district     String
  deliveryZone DeliveryZone
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([customerId])
}

model AdminUser {
  id          String          @id @default(uuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id])
  displayName String
  isActive    Boolean         @default(true)
  // TOTP MFA (Phase 4). The secret is set at enrolment and only
  // used once mfaEnabled is true after a successful code check.
  mfaSecret   String?
  mfaEnabled  Boolean         @default(false)
  roles       AdminUserRole[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  // Stable key such as super-admin, store-manager, accountant.
  key         String           @unique
  name        String
  adminUsers  AdminUserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(uuid())
  // Module.action key such as orders.edit or payments.refund.
  key   String           @unique
  roles RolePermission[]
}

model AdminUserRole {
  adminUserId String
  roleId      String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@id([adminUserId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // SHA-256 hash of the refresh token, never the token itself.
  token     String    @unique
  // Refresh rotation family (Phase 4): every token rotated from
  // one login shares a family; reuse of a rotated token revokes
  // the whole family.
  familyId  String?
  // The session that replaced this one at rotation, when it was
  // rotated (as opposed to logged out or security-revoked).
  // AuthService.refresh tells reuse apart from a plain revoked
  // session by this marker. Added with the Prisma repositories:
  // StoredSession has carried the field since Phase 4 but the
  // model had no column for it.
  replacedById String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  position  Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id           String          @id @default(uuid())
  slug         String          @unique
  name         String
  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])
  description  String?
  status       ProductStatus   @default(DRAFT)
  isFeatured   Boolean         @default(false)
  isBestSeller Boolean         @default(false)
  isNewArrival Boolean         @default(false)
  tags         String[]
  variants     ProductVariant[]
  media        ProductMedia[]
  reviews      ProductReview[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id                   String     @id @default(uuid())
  productId            String
  product              Product    @relation(fields: [productId], references: [id])
  sku                  String     @unique
  name                 String
  size                 String?
  colour               String?
  priceMinor           Int
  compareAtPriceMinor  Int?
  currency             String     @default("BDT")
  stock                Int        @default(0)
  isActive             Boolean    @default(true)
  cartItems            CartItem[]
  orderItems           OrderItem[]
  stockReservations    StockReservation[]
  stockMovements       StockMovement[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  type      MediaType @default(IMAGE)
  url       String
  alt       String    @default("")
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id           String     @id @default(uuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  sessionToken String?    @unique
  status       CartStatus @default(ACTIVE)
  currency     String     @default("BDT")
  items         CartItem[]
  abandonedCart AbandonedCart?
  createdAt     DateTime      @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId])
}

model CartItem {
  id             String         @id @default(uuid())
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id])
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPriceMinor Int
  currency       String         @default("BDT")
  addedAt        DateTime       @default(now())

  @@unique([cartId, variantId])
}

/** One reserved line of an order (inventory, per
 * docs/PRISMA_MIGRATION.md): quantity of a variant held for an
 * order from placement until the reservation is released on
 * cancellation or finalized on delivery. ProductVariant.stock is
 * the on-hand count; availability is on-hand minus the sum of
 * ACTIVE reservations, exactly as the in-memory store computes
 * it. orderId stays a plain reference (no relation) so reserve
 * and release never depend on relation write ordering. */
/** Append-only stock movement ledger (Inventory redesign),
 * written by the inventory repository on every stock change:
 * staff adjustments, order reservations, releases on
 * cancellation and finalizes on delivery. It starts at
 * deployment; earlier changes were never recorded and are not
 * backfilled. */
model StockMovement {
  id            String   @id @default(uuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  productId     String
  type          String
  deltaOnHand   Int
  deltaReserved Int
  onHandAfter   Int
  reservedAfter Int
  reference     String?
  createdAt     DateTime @default(now())

  @@index([variantId])
  @@index([productId])
  @@index([createdAt])
}

model StockReservation {
  id        String           @id @default(uuid())
  orderId   String
  variantId String
  variant   ProductVariant   @relation(fields: [variantId], references: [id])
  quantity  Int
  state     ReservationState @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([orderId])
  @@index([variantId, state])
}

/** Singleton store settings row (id is always "store"): the free
 * delivery offer switch and the manual mobile-banking receiving
 * instructions that CheckoutService and the manual banking
 * provider read. Mirrors the in-memory store's settings object. */
model StoreSettings {
  id                 String   @id
  freeDeliveryOffer  Boolean  @default(false)
  manualInstructions Json
  /** Cart recovery scalars (abandonedAfterMinutes, tokenTtlDays);
   * the sequence steps themselves live in RecoverySequenceStep.
   * Added with the Prisma repositories: the recovery settings had
   * no schema home for these two values. */
  recoverySettings   Json?
  /** Website Management settings beyond the original pair, as
   * one JSON column on the recoverySettings precedent: store
   * profile, delivery fee table and loyalty rules. Read and
   * written only through the settings repository. */
  extendedSettings   Json?
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                      String            @id @default(uuid())
  orderNumber             String            @unique
  customerId              String
  customer                Customer          @relation(fields: [customerId], references: [id])
  status                  OrderStatus       @default(PENDING)
  paymentStatus           PaymentStatus     @default(PENDING)
  address                 OrderAddress?
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  returnRequests          ReturnRequest[]
  statusEvents            OrderStatusEvent[]
  refunds                 Refund[]
  subtotalMinor           Int
  deliveryFeeMinor        Int               @default(0)
  codFeeMinor             Int               @default(0)
  discountMinor           Int               @default(0)
  totalMinor              Int
  currency                String            @default("BDT")
  firstOrderFreeDelivery  Boolean           @default(false)
  adminNote               String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  productName    String
  variantName    String?
  sku            String?
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int
  currency       String          @default("BDT")

  @@index([orderId])
}

model OrderAddress {
  id           String       @id @default(uuid())
  orderId      String       @unique
  order        Order        @relation(fields: [orderId], references: [id])
  fullName     String
  phone        String
  addressLine  String
  area         String?
  city         String
  district     String
  deliveryZone DeliveryZone
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  gateway       PaymentGateway
  channel       PaymentChannel @default(GATEWAY)
  status        PaymentStatus  @default(INITIATED)
  amountMinor   Int
  currency      String         @default("BDT")
  providerTxnId String?        @unique
  // Manual mobile banking only: what the customer reported at
  // confirmation, and the receiving instructions shown to them.
  senderNumber  String?
  customerTxnId String?
  instructions  Json?
  events        PaymentEvent[]
  refunds       Refund[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

model PaymentEvent {
  id        String         @id @default(uuid())
  paymentId String
  payment   Payment        @relation(fields: [paymentId], references: [id])
  type      String
  status    PaymentStatus?
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([paymentId])
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String
  payment     Payment      @relation(fields: [paymentId], references: [id])
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  amountMinor Int
  currency    String       @default("BDT")
  status      RefundStatus @default(REQUESTED)
  reason      String?
  // What happened at the gateway step, in plain words. Null for
  // manual refunds that never touch a gateway.
  gatewayNote String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([paymentId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------

model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/** One webhook delivery from a payment gateway. The (gateway,
 * providerEventId) pair is unique so a redelivery is recognised
 * as a duplicate and its effects are not applied twice. */
model WebhookEvent {
  id              String         @id @default(uuid())
  gateway         PaymentGateway
  providerEventId String
  paymentId       String?
  payload         Json?
  createdAt       DateTime       @default(now())

  @@unique([gateway, providerEventId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Visitor, Buyer Intelligence, CRM and Leads (Phase 5)
// ---------------------------------------------------------------------------
//
// Privacy rules, from docs/ADMIN_PORTAL.md and the admin master
// structure: anonymous visitors are identified only by random
// first-party visitor and session ids. No model below carries an
// IP address, a device fingerprint or any other covert identifier.
// Events link to a customer only through an authenticated or
// consented flow, recorded as an IdentityLink with its basis.

enum IdentityStatus {
  ANONYMOUS
  KNOWN_CUSTOMER
  GUEST_CHECKOUT
  UNVERIFIED_CONTACT
}

enum ConsentScope {
  ANALYTICS
  MARKETING
}

enum ConsentStatus {
  GRANTED
  DENIED
}

enum IdentityLinkBasis {
  AUTHENTICATED
  GUEST_CHECKOUT
  CONTACT_FORM
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  INTERESTED
  FOLLOW_UP_REQUIRED
  NEGOTIATION
  CONVERTED
  LOST
  DO_NOT_CONTACT
}

enum LeadSource {
  BUYER_INTELLIGENCE
  GUEST_CHECKOUT
  CONTACT_FORM
  MANUAL
}

model VisitorSession {
  id             String         @id
  visitorId      String
  identityStatus IdentityStatus @default(ANONYMOUS)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id])
  events         VisitorEvent[]
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())

  @@index([visitorId])
  @@index([customerId])
  @@index([lastSeenAt])
}

model VisitorEvent {
  id         String         @id @default(uuid())
  visitorId  String
  sessionId  String
  session    VisitorSession @relation(fields: [sessionId], references: [id])
  type       String
  customerId String?
  path       String?
  payload    Json?
  /** False when the visitor denied the marketing consent scope:
   * the event is kept as an operational record but excluded from
   * every marketing use. */
  marketingUsable Boolean   @default(true)
  occurredAt DateTime       @default(now())

  @@index([visitorId])
  @@index([sessionId])
  @@index([customerId])
  @@index([occurredAt])
}

model ConsentRecord {
  id        String        @id @default(uuid())
  visitorId String
  scope     ConsentScope
  status    ConsentStatus
  createdAt DateTime      @default(now())

  @@index([visitorId, scope])
}

model IdentityLink {
  id         String            @id @default(uuid())
  visitorId  String
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  basis      IdentityLinkBasis
  createdAt  DateTime          @default(now())

  @@unique([visitorId, customerId])
  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  body       String
  authorId   String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerTag {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  tag        String
  createdAt  DateTime @default(now())

  @@unique([customerId, tag])
  @@index([customerId])
}

model Lead {
  id           String     @id @default(uuid())
  status       LeadStatus @default(NEW)
  source       LeadSource
  visitorId    String?
  sessionId    String?
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  fullName     String?
  email        String?
  phone        String?
  score        Int?
  contactBasis String?
  assigneeId   String?
  optedOut     Boolean    @default(false)
  optedOutAt   DateTime?
  note         String?
  scoreRecord  LeadScore?
  assignments  LeadAssignment[]
  contactAttempts LeadContactAttempt[]
  followUpTasks FollowUpTask[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([visitorId])
  @@index([customerId])
  @@index([assigneeId])
}

model LeadScore {
  id         String   @id @default(uuid())
  leadId     String   @unique
  lead       Lead     @relation(fields: [leadId], references: [id])
  score      Int
  breakdown  Json?
  computedAt DateTime @default(now())
}

model LeadAssignment {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id])
  assigneeId   String
  assignedById String
  createdAt    DateTime @default(now())

  @@index([leadId])
}

/** One recorded contact attempt against a lead (call, WhatsApp or
 * email), written by LeadsService.recordContactAttempt. Added
 * when the Prisma repositories were implemented: the domain type
 * LeadContactAttempt existed since Phase 5 but had no model. */
model LeadContactAttempt {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  channel   String
  purpose   String
  result    String
  note      String?
  staffId   String
  optedOut  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([leadId])
}

model FollowUpTask {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  title       String
  dueAt       DateTime?
  status      String    @default("open")
  createdById String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([status])
}

/** A recorded opt-out: contact for this lead (and, when known, this
 * customer or phone) is suppressed across leads and recovery. */
model SuppressionRecord {
  id         String   @id @default(uuid())
  leadId     String?
  customerId String?
  phone      String?
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([phone])
}

// ---------------------------------------------------------------------------
// Cart Recovery and Communication (Phase 6)
// ---------------------------------------------------------------------------
//
// Detection, the step sequence and the communication log. The
// recovery token is unguessable and unique; the public token read
// never exposes the contact fields stored here. A communication
// log entry is marked SENT only on a provider-confirmed send;
// unconfigured providers record NOT_CONFIGURED.

enum AbandonedCartStatus {
  DETECTED
  IN_RECOVERY
  RECOVERED
  CLOSED
  CANCELLED
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  SMS
  CALL
}

enum CommunicationLogStatus {
  SENT
  NOT_CONFIGURED
  FAILED
  REFUSED_SUPPRESSED
  REFUSED_CONSENT
  REFUSED_NO_CONTACT
  LOGGED
  AWAITING_STAFF
}

enum RecoveryAttemptStatus {
  SCHEDULED
  EXECUTED
  CANCELLED
  SKIPPED
}

model AbandonedCart {
  id                   String              @id @default(uuid())
  cartId               String              @unique
  cart                 Cart                @relation(fields: [cartId], references: [id])
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id])
  visitorId            String?
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  contactBasis         String?
  cartTotalMinor       Int
  currency             String              @default("BDT")
  itemCount            Int
  status               AbandonedCartStatus @default(DETECTED)
  closeReason          String?
  recoveryToken        String              @unique
  tokenExpiresAt       DateTime
  detectedAt           DateTime            @default(now())
  lastActivityAt       DateTime
  recoveredOrderNumber String?
  attempts             RecoveryAttempt[]
  communications       CommunicationLog[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([customerId])
}

model RecoveryAttempt {
  id                 String                @id @default(uuid())
  abandonedCartId    String
  abandonedCart      AbandonedCart         @relation(fields: [abandonedCartId], references: [id])
  stepNumber         Int
  channel            CommunicationChannel
  templateKey        String
  scheduledFor       DateTime
  executedAt         DateTime?
  status             RecoveryAttemptStatus @default(SCHEDULED)
  outcome            String?
  communicationLogId String?
  queueJobId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([abandonedCartId])
  @@index([status])
}

model CommunicationLog {
  id                String                 @id @default(uuid())
  channel           CommunicationChannel
  kind              String
  status            CommunicationLogStatus
  toAddress         String?
  customerId        String?
  customer          Customer?              @relation(fields: [customerId], references: [id])
  visitorId         String?
  leadId            String?
  abandonedCartId   String?
  abandonedCart     AbandonedCart?         @relation(fields: [abandonedCartId], references: [id])
  campaignId        String?
  templateKey       String?
  subject           String?
  body              String
  callOutcome       String?
  staffId           String?
  providerMessageId String?
  detail            String?
  createdAt         DateTime               @default(now())

  @@index([channel])
  @@index([status])
  @@index([customerId])
  @@index([abandonedCartId])
}

/** Staff-edited message templates (Communication Center and Cart
 * Recovery). A row here overrides the code-versioned built-in
 * template with the same key; deleting the row restores the
 * built-in. The rendered text of every send is stored on its
 * CommunicationLog entry, so later edits never rewrite history. */
model MessageTemplate {
  key       String               @id
  channel   CommunicationChannel
  subject   String?
  body      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

/** One row per sequence step: the stored, staff-editable recovery
 * sequence (the RecoveryCampaign data of the architecture docs). */
model RecoverySequenceStep {
  id           String               @id @default(uuid())
  stepNumber   Int                  @unique
  delayMinutes Int
  channel      CommunicationChannel
  templateKey  String
  updatedAt    DateTime             @updatedAt
}

// ---------------------------------------------------------------------------
// Shipping and Courier (Phase 6, chunk 2)
// ---------------------------------------------------------------------------
//
// Courier booking and tracking for Pathao, Steadfast and RedX. A
// shipment is NOT_CONFIGURED until a courier with merchant
// credentials confirms the booking: trackingId stays null and no
// booked state is invented. Courier raw statuses are preserved
// verbatim on the shipment and on every event next to their
// canonical mapping. Webhook deliveries are idempotent on
// (courier, providerEventId), like the payment WebhookEvent.

enum Courier {
  PATHAO
  STEADFAST
  REDX
}

enum ShipmentStatus {
  NOT_CONFIGURED
  CREATED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
}

model Shipment {
  id                  String         @id @default(uuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id])
  orderNumber         String
  courier             Courier
  status              ShipmentStatus @default(NOT_CONFIGURED)
  trackingId          String?
  recipientName       String
  recipientPhone      String
  recipientAddress    String
  codAmountMinor      Int            @default(0)
  currency            String         @default("BDT")
  weightKg            Float          @default(0.5)
  notConfiguredReason String?
  lastRawStatus       String?
  createdById         String?
  events              ShipmentEvent[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([courier, trackingId])
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
  status     ShipmentStatus
  rawStatus  String?
  source     String
  note       String?
  createdAt  DateTime       @default(now())

  @@index([shipmentId])
}

model CourierWebhookEvent {
  id              String   @id @default(uuid())
  courier         Courier
  providerEventId String
  shipmentId      String?
  payload         Json
  createdAt       DateTime @default(now())

  @@unique([courier, providerEventId])
}

// ---------------------------------------------------------------------------
// Admin modules build: returns, support, reviews, marketing,
// loyalty, legal, notifications, backup
// ---------------------------------------------------------------------------

enum ReturnKind {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  AWAITING_PICKUP
  IN_TRANSIT
  RECEIVED
  INSPECTION
  REFUND_PENDING
  REFUNDED
  EXCHANGE_PROCESSING
  COMPLETED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  WAITING_CUSTOMER
  WAITING_STAFF
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
  HIDDEN
}

enum CampaignChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
  ARCHIVED
}

/** A return or exchange request against a delivered order. The
 * lines are a JSON snapshot of the order lines being returned
 * (the order itself stays the record of what was sold); the
 * refund hand-off stores the Payments refund id once created. */
model ReturnRequest {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  orderNumber String
  customerId  String
  kind        ReturnKind
  status      ReturnStatus @default(REQUESTED)
  reason      String?
  note        String?
  /** Returns workflow extension: the requested resolution, the
   * customer-stated condition, the assigned inspector, the
   * recorded pickup schedule and receipt, and the inspection
   * record as JSON. */
  resolutionType    String    @default("refund")
  condition         String?
  assigneeId        String?
  pickupScheduledAt DateTime?
  receivedAt        DateTime?
  inspection        Json?
  events      ReturnEvent[]
  items       Json
  totalMinor  Int
  currency    String       @default("BDT")
  refundState String       @default("none")
  refundId    String?
  restocked   Boolean      @default(false)
  createdById String?
  decidedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([customerId])
}

/** One recorded step in a return's life (Returns redesign): a
 * status transition or a staff note action, with the acting
 * staff member and timestamp. The details timeline is built
 * from these records only. */
model ReturnEvent {
  id        String        @id @default(uuid())
  returnId  String
  request   ReturnRequest @relation(fields: [returnId], references: [id])
  status    ReturnStatus
  note      String?
  actorId   String?
  createdAt DateTime      @default(now())

  @@index([returnId])
}

/** One recorded automation execution (Automation redesign),
 * written by the flow itself as it runs: workflow key, the
 * entity it acted on, the outcome and the timing. Starts at
 * deployment; never backfilled. */
model AutomationExecution {
  id          String   @id @default(uuid())
  workflowKey String
  entityType  String
  entityId    String
  status      String
  detail      String
  startedAt   DateTime
  completedAt DateTime

  @@index([workflowKey])
  @@index([startedAt])
}

model SupportTicket {
  id            String              @id @default(uuid())
  customerId    String?
  customerName  String
  customerPhone String
  customerEmail String?
  subject       String
  category      String?
  priority      SupportPriority     @default(NORMAL)
  status        SupportTicketStatus @default(OPEN)
  assignedToId  String?
  orderNumber   String?
  channel       String              @default("admin")
  firstRespondedAt DateTime?
  resolvedAt    DateTime?
  messages      SupportTicketMessage[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@index([customerId])
}

model SupportTicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorType String
  authorId   String?
  authorName String
  body       String
  internal   Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model ProductReview {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  customerId String?
  authorName String
  rating     Int
  title      String?
  body       String
  status     ReviewStatus @default(PENDING)
  source     String       @default("staff-entered")
  verified   Boolean      @default(false)
  verificationNote String?
  orderNumber String?
  flagReason String?
  replies    Json         @default("[]")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId])
  @@index([status])
}

model Campaign {
  id           String         @id @default(uuid())
  name         String
  channel      CampaignChannel
  audienceNote String
  /** Marketing send extension: the resolved audience segment
   * and optional rules, the shared-store template or the
   * campaign's own subject and body, and the send outcome. */
  segmentKey   String         @default("all-customers")
  segmentRules Json?
  templateKey  String?
  subject      String?
  body         String?
  status       CampaignStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  sendNote     String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
}

/** A staff loyalty adjustment. Earned points are derived from
 * delivered orders and never stored; only adjustments live here. */
model LoyaltyTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  delta       Int
  reason      String
  orderId     String?
  type        String   @default("adjusted")
  referenceKey String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([referenceKey])
}

/** An editable legal document, keyed by its slug (privacy,
 * terms, returns, refund, shipping, warranty). */
model LegalDocument {
  slug           String    @id
  title          String
  body           String
  description    String    @default("")
  isCustom       Boolean   @default(false)
  publishedTitle String?
  publishedBody  String?
  publishedAt    DateTime?
  publishedById  String?
  unpublishedAt  DateTime?
  updatedById    String?
  updatedAt      DateTime  @updatedAt
}

/** One immutable publish snapshot of a legal document. */
model LegalDocumentVersion {
  id            String   @id @default(uuid())
  slug          String
  version       Int
  title         String
  body          String
  publishedById String?
  publishedAt   DateTime @default(now())

  @@unique([slug, version])
  @@index([slug])
}

/** A staff notification read mark. The feed itself is derived
 * from orders, stock and recovery records; only read state is
 * stored, one row per staff member and notification key. */
model NotificationRead {
  id              String   @id @default(uuid())
  adminUserId     String
  notificationKey String
  readAt          DateTime @default(now())
  hidden          Boolean  @default(false)

  @@unique([adminUserId, notificationKey])
}

model StaffInvitation {
  id          String    @id @default(uuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model NotificationPreference {
  adminUserId  String  @id
  categories   Json
  emailEnabled Boolean @default(false)
}

/** A staff-triggered data export record: counts per store only.
 * The export document itself is returned to the requester and
 * never stored. */
model DataExport {
  id            String   @id @default(uuid())
  requestedById String?
  counts        Json
  collections   Json     @default("[]")
  byteSize      Int      @default(0)
  createdAt     DateTime @default(now())
}

/** A stored backup snapshot (Backup redesign). The snapshot is
 * the full export JSON document, kept in the application
 * database; the checksum guards every download. */
model StoredBackup {
  id          String   @id @default(uuid())
  createdById String?
  byteSize    Int
  checksum    String
  collections Json
  snapshot    Json
  createdAt   DateTime @default(now())
}
