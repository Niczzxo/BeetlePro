# Dostelo environment inventory.
#
# Names and purposes only: every value stays empty here. Real
# values live in the host's environment or an uncommitted .env
# file. Leaving a provider's variables empty keeps that
# provider unconfigured, and the API then answers honestly
# (not-configured) instead of pretending to send or charge.

# --- Runtime -------------------------------------------------
# NODE_ENV: runtime mode; "production" turns on HSTS, tightens
# CORS to the two origins below, and requires AUTH_SECRET.
NODE_ENV=
# API_PORT: port the API listens on (default 4000).
API_PORT=
# DATABASE_URL: PostgreSQL connection string. Reserved for the
# Prisma swap (docs/PRISMA_MIGRATION.md); not read by the
# in-memory build yet.
DATABASE_URL=
# REDIS_URL: Redis connection string. When set, the job queue
# seam runs on BullMQ; when unset, it runs on the in-process
# queue and scheduled jobs do not survive restarts.
REDIS_URL=
# DOSTELO_TEST_DATABASE_URL: disposable PostgreSQL database
# for the Prisma integration suite (apps/api/src/testing).
# The suite truncates every table in it; never point it at a
# database with data worth keeping.
DOSTELO_TEST_DATABASE_URL=
# STOREFRONT_URL: public storefront origin; CORS allowlist and
# the base for recovery links sent to customers.
STOREFRONT_URL=
# ADMIN_URL: admin portal origin; CORS allowlist.
ADMIN_URL=
# API_URL: public API base URL, used to build payment gateway
# callback and webhook URLs.
API_URL=

# --- Authentication and staff seeding ------------------------
# AUTH_SECRET: JWT signing secret, at least 16 characters.
# Required in production: the API refuses to boot without it.
AUTH_SECRET=
# AUTH_ACCESS_TTL_SECONDS: access token lifetime (default 900).
AUTH_ACCESS_TTL_SECONDS=
# AUTH_REFRESH_TTL_DAYS: refresh token lifetime (default 30).
AUTH_REFRESH_TTL_DAYS=
# ADMIN_SEED_EMAIL: first staff account, seeded at startup when
# both seed values are set. No default credentials exist.
ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD: password for the seeded staff account.
ADMIN_SEED_PASSWORD=
# ADMIN_SEED_ROLE: role key for the seeded account (defaults
# to super-admin).
ADMIN_SEED_ROLE=

# --- Payments ------------------------------------------------
# SSLCOMMERZ_STORE_ID: SSLCommerz merchant store id.
SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD: SSLCommerz store password; also
# the IPN signature secret.
SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_MODE: sandbox or live (default sandbox).
SSLCOMMERZ_MODE=
# SSLCOMMERZ_API_BASE_URL: override for the gateway API base.
SSLCOMMERZ_API_BASE_URL=
# PAYMENTS_BKASH_MODE: manual (default, staff-verified mobile
# banking) or gateway (tokenized bKash API).
PAYMENTS_BKASH_MODE=
# BKASH_APP_KEY: bKash gateway app key.
BKASH_APP_KEY=
# BKASH_APP_SECRET: bKash gateway app secret.
BKASH_APP_SECRET=
# BKASH_USERNAME: bKash gateway merchant username.
BKASH_USERNAME=
# BKASH_PASSWORD: bKash gateway merchant password.
BKASH_PASSWORD=
# BKASH_API_BASE_URL: override for the bKash API base.
BKASH_API_BASE_URL=
# BKASH_WEBHOOK_SECRET: verifies bKash webhook deliveries.
BKASH_WEBHOOK_SECRET=

# --- Communications ------------------------------------------
# WHATSAPP_ACCESS_TOKEN: WhatsApp Cloud API access token.
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: WhatsApp sender phone number id.
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_BASE_URL: override for the WhatsApp API base.
WHATSAPP_API_BASE_URL=
# EMAIL_PROVIDER_API_KEY: transactional email provider key.
EMAIL_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_URL: transactional email provider endpoint.
EMAIL_PROVIDER_API_URL=
# EMAIL_FROM: sender address for outgoing email.
EMAIL_FROM=
# SMS_API_KEY: SMS gateway key.
SMS_API_KEY=
# SMS_API_URL: SMS gateway endpoint.
SMS_API_URL=
# SMS_SENDER_ID: SMS sender id shown to recipients.
SMS_SENDER_ID=

# --- Cart recovery -------------------------------------------
# CART_ABANDONED_AFTER_MINUTES: inactivity before a cart counts
# as abandoned (default 60); seeds staff-editable settings.
CART_ABANDONED_AFTER_MINUTES=
# CART_RECOVERY_SCAN_MINUTES: worker rescan interval (default
# 15).
CART_RECOVERY_SCAN_MINUTES=
# CART_RECOVERY_TOKEN_TTL_DAYS: recovery link lifetime seed
# (default 30).
CART_RECOVERY_TOKEN_TTL_DAYS=

# --- Couriers ------------------------------------------------
# PATHAO_CLIENT_ID: Pathao merchant client id.
PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET: Pathao merchant client secret.
PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME: Pathao merchant username.
PATHAO_USERNAME=
# PATHAO_PASSWORD: Pathao merchant password.
PATHAO_PASSWORD=
# PATHAO_STORE_ID: Pathao pickup store id.
PATHAO_STORE_ID=
# PATHAO_API_BASE_URL: override for the Pathao API base.
PATHAO_API_BASE_URL=
# PATHAO_WEBHOOK_SECRET: verifies Pathao status callbacks.
PATHAO_WEBHOOK_SECRET=
# STEADFAST_API_KEY: Steadfast merchant API key.
STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY: Steadfast merchant secret key.
STEADFAST_SECRET_KEY=
# STEADFAST_API_BASE_URL: override for the Steadfast API base.
STEADFAST_API_BASE_URL=
# STEADFAST_WEBHOOK_SECRET: verifies Steadfast status callbacks.
STEADFAST_WEBHOOK_SECRET=
# REDX_ACCESS_TOKEN: RedX merchant API access token.
REDX_ACCESS_TOKEN=
# REDX_API_BASE_URL: override for the RedX API base.
REDX_API_BASE_URL=
# REDX_WEBHOOK_SECRET: verifies RedX status callbacks.
REDX_WEBHOOK_SECRET=

# --- Next.js apps (set per app, not read by the API) ---------
# NEXT_PUBLIC_API_URL: API base URL inlined into the storefront
# and admin bundles at build time (default
# http://localhost:4000). Set it before building either app.
NEXT_PUBLIC_API_URL=
